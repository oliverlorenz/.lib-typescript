{
  "name": "@oliverlorenz/<REPO_NAME>",
  "version": "0.0.0-semantically-released",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "bootstrap": "scripts/init-from-template.sh",
    "build": "npm run clean && tsc",
    "check:all": "npm run git-hook:pre-push && npm run git-hook:pre-commit",
    "clean": "del-cli ./dist",
    "git-hook:pre-commit": "npm test",
    "git-hook:pre-push": "npm run lint:eslint && npm run lint:prettier && npm test",
    "lint:eslint": "eslint \"src/**/*.ts\"",
    "lint:prettier": "prettier \"src/**/*.ts\" --cache --check",
    "lint:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json && tsc-strict",
    "lint:knip": "knip",
    "lint:md": "markdownlint-cli2 \"*.md\" \"!CHANGELOG.md\"",
    "lint:links": "markdown-link-check README.md --config .markdown-link-check.json",
    "lint:readme": "node scripts/lint-readme.mjs",
    "lint:publint": "publint",
    "lint:attw": "attw --pack . --profile esm-only",
    "lint:audit": "audit-ci --config audit-ci.jsonc",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:types && npm run lint:knip && npm run lint:md && npm run lint:readme && npm run lint:publint",
    "prepare": "husky",
    "test": "npm run build && npm run test:coverage",
    "test:watch": "vitest --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverlorenz/<REPO_NAME>.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/oliverlorenz/<REPO_NAME>/issues"
  },
  "homepage": "https://github.com/oliverlorenz/<REPO_NAME>#readme",
  "description": "",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.11",
    "audit-ci": "^7.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "del-cli": "^8.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.46.1",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.8",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "typescript-strict-plugin": "^2.4.4",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
