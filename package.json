{
  "name": "@oliverlorenz/<REPO_NAME>",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && tsc && npm run docs:generate",
    "check:all": "npm run git-hook:pre-push && npm run git-hook:pre-commit",
    "clean": "del-cli ./dist",
    "docs:generate": "del-cli ./docs && mkdir -p ./temp && npm run test:docs && npx api-documenter markdown --input-folder ./temp --output-folder ./docs/api",
    "git-hook:pre-commit": "npm test",
    "git-hook:pre-push": "npm run lint:eslint && npm run lint:prettier && npm test",
    "lint:eslint": "eslint ./src --ext .ts",
    "lint:prettier": "prettier \"src/**/*.ts\" --cache --check",
    "lint:types": "tsc --noEmit --skipLibCheck && tsc-strict",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:types",
    "postinstall": "npx husky init",
    "prepare": "husky",
    "test:docs": "api-extractor run --local",
    "test": "npm run build && npm run test:coverage && npm run test:docs",
    "test:watch": "jest --coverage --coverage-reporters html --watch-all",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverlorenz/<REPO_NAME>.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/oliverlorenz/<REPO_NAME>/issues"
  },
  "homepage": "https://github.com/oliverlorenz/<REPO_NAME>#readme",
  "description": "",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.33.0",
    "@microsoft/api-documenter": "^7.29.1",
    "@microsoft/api-extractor": "^7.57.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prettier": "^3.5.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.3",
    "typescript-strict-plugin": "^2.4.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {}
}
